# Save as /etc/codehive/deploy.env on the server, chmod 600.
# This file is sourced by Bash and parsed by Compose: use simple literal values.
SITE_ROOT=/www/wwwroot/codehive.asia
SITE_ORIGIN=https://codehive.asia
SITE_ALIAS_ORIGIN=https://www.codehive.asia
# auto detects system Nginx with BaoTa vhosts; alternatives: system, baota.
NGINX_MODE=auto
# Fullstack only. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_64_hex_characters
