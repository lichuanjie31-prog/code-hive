CODEHIVE_DATABASE_URL=sqlite:///./codehive-v2.db
CODEHIVE_ENVIRONMENT=development
CODEHIVE_COOKIE_SECURE=false
CODEHIVE_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:4173","http://localhost:4173"]
CODEHIVE_CONTACT_REQUIRED=false
CODEHIVE_SESSION_HOURS=168
